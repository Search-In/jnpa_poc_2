# ============================================================================
# JNPA Use Case 2 — Cargo Handling & Logistics Optimization
# Environment template (§15). Copy to `.env`. NEVER commit `.env`.
# `npm run dev` / `pnpm dev` runs the WHOLE dashboard in mock mode with ZERO
# of these credentials set. Only set the *_live values once onboarding completes.
# ============================================================================

# ---- Master data-source switch (§1, §5) -----------------------------------
# mock  = MockAdapter backed by packages/sim (offline, zero credentials)
# live  = LiveAdapter calling the connector services (requires onboarding below)
DATA_MODE=mock

# ---- POC-3 shared Cargo API (single source of truth for cargo) -------------
# Cargo data is served by the POC-3 gateway (GET /api/cargo); POC-2 keeps no
# cargo store. In dev the web app proxies /poc3 → POC3_URL (avoids CORS). For a
# deployed build set VITE_CARGO_API_BASE to the gateway origin instead.
POC3_URL=https://traffic-three.searchintech.in
# VITE_CARGO_API_BASE=https://<poc3-gateway-host>
# VITE_CARGO_SOURCE=poc3   # set to `mock` to keep cargo on the offline simulator

# JNPA Simulated Port-Data API feed card on the Integration tab (mode, per-group
# watermarks, volumes, observed defects). HIDDEN unless this is affirmatively
# set — unset/empty/anything else keeps it off, and a hidden card makes no
# requests. Turn it on for integration review; leave it off for a clean demo,
# where the honest reading today is "DISABLED, watermarks days old".
# VITE_SHOW_JNPA_FEED=true

# ---- NLDS Logistics Data Bank (Manage → Track) ----------------------------
# Dev proxy: /ldb → LDB_URL. The Track dialog calls
# /ldb/api/ldb/container/search?cntrNo=…&searchType=39 (Single).
LDB_URL=https://ldb.co.in
# VITE_LDB_API_BASE=/ldb
# VITE_LDB_SEARCH_TYPE=39
# ---- Sign-in ---------------------------------------------------------------
# Turns on the login gate. Users sign in with their own JNPA DTCCC account
# against POC-3's POST /api/auth/login — the same endpoint, the same
# core.app_user accounts and the same 8 h JWT that UC-3's console uses.
# Leave unset for the credential-free mock demo.
# VITE_AUTH_ENABLED=true
#
# There are deliberately NO username/password variables here. Vite inlines
# VITE_* at BUILD time, so any credential put here is compiled into the shipped
# JS bundle and readable by anyone with devtools.
#
# Optional: inject a pre-issued POC-3 JWT verbatim for unattended/service use.
# VITE_CARGO_API_TOKEN=

# ---- ULIP (Unified Logistics Interface Platform) — PRIMARY connector -------
# Onboarding (KELTRON/JNPA only): register at goulip.in -> submit use-case ->
# sign NDA -> receive TEST API token -> integrate + demo -> PRODUCTION token.
# Until then leave blank; ULIP connector runs against packages/sim simulator.
ULIP_BASE_URL=
ULIP_API_KEY=
# Staleness budget (minutes) before a cached ULIP snapshot is considered stale.
ULIP_CACHE_STALENESS_MIN=60

# ---- ICEGATE / ICES 1.5 Sea-Custodian message exchange --------------------
# Onboarding: IEC (Import-Export Code) + Class-3 DSC + ICES 1.5 onboarding.
# DSC thumbprint identifies the signing certificate for message exchange.
ICEGATE_BASE_URL=
ICEGATE_CLIENT_ID=
ICEGATE_DSC_THUMBPRINT=

# ---- FOIS / rail (CRIS) ----------------------------------------------------
# Primary path is FOIS-via-ULIP track/trace (one fewer credential). Set
# FOIS_VIA_ULIP=true to route rail through the ULIP connector. Direct CRIS is
# the JNPA-facilitated fallback.
FOIS_VIA_ULIP=true
CRIS_FOIS_URL=

# ---- TOS (Terminal Operating System) — per terminal, polyglot --------------
# MODE = EDIFACT | X12 | REST | FILE_DROP. See config/terminals.json for the
# canonical terminal list; one block per operating terminal.
TOS_NSICT_MODE=EDIFACT
TOS_NSICT_URL=
TOS_NSICT_DROP_DIR=

TOS_NSIGT_MODE=REST
TOS_NSIGT_URL=
TOS_NSIGT_DROP_DIR=

TOS_GTI_MODE=X12
TOS_GTI_URL=
TOS_GTI_DROP_DIR=

TOS_BMCT_MODE=REST
TOS_BMCT_URL=
TOS_BMCT_DROP_DIR=

TOS_JNPCT_MODE=FILE_DROP
TOS_JNPCT_URL=
TOS_JNPCT_DROP_DIR=./data/file-drop/jnpct

# ---- e-seal RFID reader feed -----------------------------------------------
ESEAL_FEED_URL=

# ---- Shipping line portals / EDI (IAL/EAL, D/O, empty-pool) -----------------
SHIPLINE_MAERSK_URL=
SHIPLINE_MSC_URL=
SHIPLINE_CMACGM_URL=

# ---- ArcGIS (spatial spine — same WebMap item as UC1) ----------------------
# PoC may run on ArcGIS Online; production target = ArcGIS Enterprise 11.3.
ARCGIS_PORTAL_URL=https://www.arcgis.com
ARCGIS_WEBMAP_ID=
# OAuth app client id for ArcGIS named-user / app login (optional in mock)
ARCGIS_APP_ID=

# ---- AuthN/Z (OAuth2/OIDC + JWT) — RBAC §9 --------------------------------
OIDC_ISSUER=
OIDC_AUDIENCE=jnpa-uc2
OIDC_CLIENT_ID=
# Dev-only HS256 secret for the mock token issuer; replace with OIDC in prod.
JWT_DEV_SECRET=dev-only-insecure-change-me

# ---- Event backbone (Kafka / Redpanda) ------------------------------------
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=jnpa-uc2
# CloudEvents source prefix
CLOUDEVENTS_SOURCE=urn:jnpa:uc2

# ---- Data stores -----------------------------------------------------------
# NOTE: host Homebrew postgres often owns 5432 -> container publishes 5433.
PG_URL=postgresql://jnpa:jnpa@localhost:5433/jnpa_uc2
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=jnpa-uc2-raw

# ---- Gateway / service ports ----------------------------------------------
GATEWAY_PORT=8080
DEMO_CONSOLE_PORT=5174
WEB_PORT=5173

# ---- Compliance posture ----------------------------------------------------
AUDIT_RETENTION_DAYS=180
DPDP_PURPOSE_LIMITATION=true

# ---- UC-2 model services (UC2-015) -----------------------------------------
# The four AI containers listen on 8200 internally; docker-compose publishes each
# on a distinct host port. The dev proxy sends /ai/gate-queue here, so the browser
# reaches the model without it being internet-facing.
# Stopping this container is the demo: the Gate panel's badge flips MODEL →
# HEURISTIC within one refetch, which is what proves the wire is real.
AI_GATE_QUEUE_URL=http://localhost:8202
# Deployed build: point the browser straight at a same-origin path instead.
# VITE_AI_GATE_QUEUE_BASE=/ai/gate-queue
