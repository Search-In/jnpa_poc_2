# ============================================================================
# JNPA UC2 — AWS single-EC2 demo env. Copy to `.env` ON THE EC2 BOX, fill in,
# then `docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d`.
# `.env` is gitignored — NEVER commit it.
# ============================================================================

# ---- Web bundle data mode — NOT SETTABLE HERE (UC2-064) --------------------
# This file is read by docker compose at RUNTIME. The dashboard bundle is built
# on the CI runner, and Vite inlines VITE_* at BUILD time, so nothing set here
# can reach it. WEB_DATA_MODE lived here for months claiming `live` while the
# deployed bundle was mock, because apps/web/Dockerfile never read the build arg
# it was passed through.
#
# To change the dashboard's base data mode, set the VITE_DATA_MODE repository
# variable, which the deploy workflow passes to the build step. Unset means the
# in-app default: mock. Note this affects only the BASE adapter — cargo, customs
# and the export chain come from POC-3 regardless (VITE_CARGO_SOURCE).

# ---- Gateway data mode -----------------------------------------------------
# Stays `mock` for the PoC: the gateway serves deterministic simulated data.
# Flip to `live` only after the connector onboarding in .env.example is complete.
DATA_MODE=mock

# ---- Secrets (CHANGE THESE) ------------------------------------------------
# JWT signing secret for the gateway dev-token endpoint. Generate a strong value:
#   openssl rand -hex 32
JWT_DEV_SECRET=CHANGE-ME-openssl-rand-hex-32

# Audience claim the gateway validates tokens against.
OIDC_AUDIENCE=jnpa-uc2

# ---- Internal datastore creds (not exposed to the host on EC2) -------------
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=jnpa-minio
MINIO_ROOT_PASSWORD=change-me-minio

# ---- Live-data onboarding (leave blank until granted) ----------------------
# When DATA_MODE=live, also fill the credentials from .env.example here
# (ULIP_API_KEY, ICEGATE_*, TOS_*, ARCGIS_*, etc.).
