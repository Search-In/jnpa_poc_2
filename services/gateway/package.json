{
  "name": "@jnpa/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API gateway/BFF (prompt §1, §13, §14) — OAuth2/OIDC + JWT, claim-based RBAC, rate-limit, health-card aggregation, gate-automation feed, all /api/* endpoints.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@jnpa/schemas": "workspace:*",
    "@jnpa/sim": "workspace:*",
    "@jnpa/kpi": "workspace:*",
    "@jnpa/data": "workspace:*",
    "@jnpa/scenarios": "workspace:*",
    "@jnpa/notifications": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
