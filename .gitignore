# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo
coverage/
.vite/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ML model artifacts (versioned out-of-band; metrics.json IS committed)
services/ai/**/models/*.txt
services/ai/**/models/*.bin
services/ai/**/models/*.pkl
services/ai/**/models/*.joblib
!services/ai/**/models/.gitkeep

# Env / secrets — only .env.example is committed
.env
.env.local
.env.*.local
!.env.example

# Object store / data artifacts (raw EDI dumps in mock runs)
data/object-store/
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

*.md

# ── UC-II AI/ML model service ────────────────────────────────────────────
# The 43 MB read-only WS2 corpus is deliberately NOT committed. Six of the
# seven models degrade without it and ml/data/corpus/README.md records exactly
# what that costs. Copy the tree in locally; this keeps it from being committed
# by accident.
ml/data/corpus/UC-II_Cargo_Handling/
# Generated per run — regenerated by `python run.py uc2`, and the inference log
# grows without bound. The committed sample responses under out/uc2/*.json are
# re-added by the negation below.
ml/out/uc2/inference_log.jsonl

# The rule above ignores EVERY .md in this repository, so a doc written for this
# feature would silently never be committed. These are the ones that document
# the model service and must travel with it.
!ml/**/*.md
!docs/ML_MODELS.md