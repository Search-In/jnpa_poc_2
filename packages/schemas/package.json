{
  "name": "@jnpa/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical entity types + EDI/X12/ICES/ULIP mappers for JNPA UC2 (§3, §4). The contract every service binds to.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./entities": "./dist/entities/index.js",
    "./mappers": "./dist/mappers/index.js",
    "./json-schema": "./dist/json-schema/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
