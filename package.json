{
  "name": "jnpa-uc2-cargo-logistics",
  "version": "0.1.0",
  "private": true,
  "description": "JNPA Use Case 2 — Improved Cargo Handling & Logistics Optimization Digital Twin (Tender GEM/2026/B/7297343, Appendix C §2.3)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jnpa/web dev",
    "dev:console": "pnpm --filter @jnpa/demo-console dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r test",
    "test:schemas": "pnpm --filter @jnpa/schemas test",
    "lint": "eslint . --ext .ts,.tsx,.mjs,.cjs --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "poc-selftest": "tsx scripts/poc-selftest/index.ts",
    "ingest:reference": "pnpm --filter @jnpa/sim build && pnpm --filter @jnpa/data build && node scripts/ingest-reference/index.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
